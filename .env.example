# LearnMate AI - Environment Configuration Example
# Copy this file to .env and provide your API keys if enabling live cloud LLM providers.
# DO NOT COMMIT YOUR REAL .ENV FILE OR SECRETS TO GIT.

# Application Port
PORT=3000

# Optional: Gemini / Google AI Studio API Key for live multimodal reasoning
VITE_GEMINI_API_KEY=""

# Optional: Vector DB / Embeddings service endpoint
VITE_VECTOR_DB_ENDPOINT=""

# Mock Mode (default: true for instant hackathon demonstration)
VITE_ENABLE_MOCK_RAG="true"
